# Copy to .env (or set in your host's dashboard). The backend reads these.

# Port the API listens on (hosts usually inject this).
PORT=4000



# Set in production. Comma-separated allowed frontend origins for CORS.
# e.g. https://app.synthica.org,https://www.synthica.org
CORS_ORIGINS=
# Set NODE_ENV=production on your host. The backend refuses to boot without
# AUTH_SECRET in production.
# Base URL of the dashboards (used in verification / password-reset email links).
FRONTEND_URL=

# Discord webhook for editorial queue notifications. The Director can also set
# this in the dashboard; setting it here makes it persist across restarts.
DISCORD_WEBHOOK_URL=

# Optional second notification channel — a relay (Twilio/Make/Zapier webhook)
# that forwards a JSON {text} payload to a WhatsApp number/group.
WHATSAPP_WEBHOOK_URL=

# Google Sign-In. Create an OAuth client (type: Web) in Google Cloud Console.
# Put the SAME client id here and in the dashboards build as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Transactional email (optional). Without it, decision emails are logged only.
RESEND_API_KEY=
EMAIL_FROM=Synthica <noreply@synthica.org>

# Data source: "memory" (default, in-memory seed) or "sheets" (Google Sheets).
DATA_PROVIDER=memory

# ---- Required when DATA_PROVIDER=sheets ------------------------------------
# The spreadsheet id from its URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEETS_SPREADSHEET_ID=

# Service-account auth. Use ONE of these:
#  (a) inline JSON (handy for hosts that only take env vars):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}
#  (b) or a path to the JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
